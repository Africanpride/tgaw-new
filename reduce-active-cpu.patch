new file mode 100644
index 0000000..981c792
--- /dev/null
+++ b/lib/client/pulse.ts
@@ -0,0 +1,23 @@
+export interface PulseData {
+	dock: { todayBookings: number; unreadMessages: number };
+	slots: { signature: string; count: number; latest: string | null };
+}
+
+const SHARE_WINDOW_MS = 5_000;
+let inflight: Promise<PulseData | null> | null = null;
+let fetchedAt = 0;
+
+/**
+ * Shared fetch for /api/v1/dashboard/pulse. Every component that needs it
+ * calls this; calls within SHARE_WINDOW_MS reuse the same request, so N
+ * subscribers still cost one invocation per poll cycle.
+ */
+export function fetchPulse(): Promise<PulseData | null> {
+	if (inflight && Date.now() - fetchedAt < SHARE_WINDOW_MS) return inflight;
+	fetchedAt = Date.now();
+	inflight = fetch("/api/v1/dashboard/pulse", { cache: "no-store" })
+		.then((res) => (res.ok ? res.json() : null))
+		.then((body) => (body?.success ? (body.data as PulseData) : null))
+		.catch(() => null);
+	return inflight;
+}
diff --git a/lib/services/slotSignature.ts b/lib/services/slotSignature.ts
new file mode 100644
index 0000000..e0ac2f3
--- /dev/null
+++ b/lib/services/slotSignature.ts
@@ -0,0 +1,17 @@
+import { prisma } from "@/lib/db/prisma";
+
+/** Count + latest updatedAt of the user's upcoming bookings. */
+export async function getSlotSignature(userId: string) {
+	const today = new Date().toISOString().split("T")[0];
+	const where = { bookedBy: userId, date: { gte: today } };
+	const [latest, count] = await Promise.all([
+		prisma.slot.findFirst({
+			where,
+			orderBy: { updatedAt: "desc" },
+			select: { updatedAt: true },
+		}),
+		prisma.slot.count({ where }),
+	]);
+	const latestIso = latest?.updatedAt.toISOString() ?? null;
+	return { signature: `${count}:${latestIso ?? "none"}`, count, latest: latestIso };
+}
